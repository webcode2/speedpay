DATABASE_URL=postgresql://solar:solar@localhost:5432/solar_investment
NODE_ENV=development
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@solar.local
SEED_ADMIN_PASSWORD=ChangeMeNow!123
SEED_ADMIN_NAME=Super Admin
SESSION_TTL_DAYS=30

# Object storage: local (dev) or r2 (prod)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
# Required when STORAGE_DRIVER=r2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Payments: mock (dev) — real providers later
PAYMENT_PROVIDER=mock
